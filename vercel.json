{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(?:index\\.html)?",
      "has": [{ "type": "host", "value": "about.fsocietypk.tech" }],
      "dest": "/about.html"
    },
    {
      "src": "/api/v1/team/certificates/([a-fA-F0-9]{24})/file",
      "dest": "https://api.fsocietypk.tech/api/v1/team/certificates/$1/file"
    },
    {
      "src": "/api/v1(?:/(.*))?",
      "dest": "http://16.171.55.64:5000/api/v1/$1"
    },
    { "handle": "filesystem" },
    {
      "src": "/.*",
      "has": [{ "type": "host", "value": "about.fsocietypk.tech" }],
      "dest": "/about.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
